#!/bin/sh
#
# PROVIDE: {{SERVICE_NAME}}
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# Generated by deploy/deploy - do not edit the installed copy by hand

. /etc/rc.subr

name="{{RC_NAME}}"
rcvar="${name}_enable"
pidfile="/var/run/${name}.pid"

# daemon(8) supervises gunicorn and restarts it if it crashes (like systemd's Restart=always)
command="/usr/sbin/daemon"
command_args="-P ${pidfile} -r -t ${name} -o /var/log/${name}.log {{VENV_BIN}}/gunicorn --bind 127.0.0.1:{{PORT}} --workers 3 --chdir {{WORKDIR}} --user {{USER}} --group {{GROUP}} DBRegatta.wsgi:application"

load_rc_config "$name"
run_rc_command "$1"
