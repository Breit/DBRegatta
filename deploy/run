#!/usr/bin/env bash

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
. "$SCRIPT_DIR/config"
. "$SCRIPT_DIR/helpers"

# Server is managed by systemd (Linux) or rc.d (FreeBSD). This script is kept
# as a convenience shortcut for manual restarts, e.g. from a cron job.
service_restart
